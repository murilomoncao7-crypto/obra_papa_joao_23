# URL pública confirmada, sem barra final. Necessária para canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=

# Identificadores públicos do projeto Sanity. Não são credenciais.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Token de leitura com papel Viewer, usado somente no servidor e no preview autenticado.
SANITY_API_TOKEN=

# Segredo longo e aleatório usado para verificar a assinatura do webhook do Sanity.
SANITY_REVALIDATE_SECRET=

# Painel próprio /gestao. Somente servidor; nunca use NEXT_PUBLIC_ nestes campos.
SANITY_EDITOR_TOKEN=
EDITOR_USERNAME=
# Hash scrypt no formato salt:hash. Gere com node scripts/configure-editor.mjs.
EDITOR_PASSWORD_HASH=
EDITOR_SESSION_SECRET=
